{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes-luat.local/schemas/evaluation-dataset.schema.json",
  "title": "AES Luat RAG evaluation dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "cases"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "created_by": {"type": "string"},
    "reviewed_by": {"type": "string"},
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "factRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "any_of", "patterns"],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "any_of": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "patterns": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "answerRubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_facts", "forbidden_facts", "minimum_fact_coverage"],
      "properties": {
        "required_facts": {
          "type": "array",
          "items": {"$ref": "#/$defs/factRule"}
        },
        "forbidden_facts": {
          "type": "array",
          "items": {"$ref": "#/$defs/factRule"}
        },
        "minimum_fact_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "citationGroup": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Physical provision_id accepted for this evidence requirement. Never provision_key."
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "category",
        "question",
        "expected_statuses",
        "gold_answer",
        "gold_citation_groups",
        "answer_rubric"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "category": {
          "enum": ["single_hop", "multi_hop", "out_of_scope", "temporal_aware"]
        },
        "question": {"type": "string", "minLength": 1},
        "expected_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["full_answer", "partial_answer", "refusal"]}
        },
        "gold_answer": {"type": "string"},
        "gold_citation_groups": {
          "type": "array",
          "items": {"$ref": "#/$defs/citationGroup"}
        },
        "answer_rubric": {"$ref": "#/$defs/answerRubric"},
        "as_of_date": {
          "type": "string",
          "format": "date",
          "description": "Mốc thời gian được nêu trực tiếp trong câu hỏi temporal-aware."
        },
        "expected_warning_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "require_temporal_warning": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"category": {"const": "temporal_aware"}}},
          "then": {"required": ["as_of_date"]}
        }
      ]
    }
  }
}
