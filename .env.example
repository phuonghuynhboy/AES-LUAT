
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_MODEL=gemini-3.5-flash-lite

# Retrieval/generation settings used by the official benchmark run.
RAG_RETRIEVE_TOP_N=8
RAG_MAX_CONTEXT_CHARS=20000
RAG_MAX_CHUNK_CHARS=2000

# Comma-separated explicit origins; wildcard is rejected.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173